{
  "name": "trading-wens",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @trading-wens/frontend dev",
    "build": "pnpm --filter @trading-wens/frontend build",
    "preview": "pnpm --filter @trading-wens/frontend preview",
    "lint": "pnpm --filter @trading-wens/frontend lint",
    "typecheck": "pnpm --filter @trading-wens/frontend typecheck",
    "test": "pnpm --filter @trading-wens/frontend test",
    "format": "pnpm --filter @trading-wens/frontend format",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  }
}
