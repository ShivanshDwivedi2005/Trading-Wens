# Copy the values needed by each service into its local .env file.
# Never place real credentials in this example.

# Application
APP_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1
BACKEND_ADDRESS=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_SUPABASE_URL=
AUTH_SUPABASE_PUBLISHABLE_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_DATA_REST_URL=https://data.alpaca.markets
ALPACA_TRADING_REST_URL=https://paper-api.alpaca.markets

# Supabase authentication and PostgreSQL
# API: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://user:password@localhost:5432/trading_wens
CRON_SECRET=replace-with-a-long-random-value
CRON_SECRET_PREVIOUS=

# Redis queue and short-lived cache
REDIS_URL=redis://localhost:6379/0

# Source selection
NEWS_PROVIDER=gdelt
SOCIAL_PROVIDER=reddit
INGESTION_INTERVAL_SECONDS=60

# GDELT news API (no API key is required)
# API: https://api.gdeltproject.org/api/v2/doc/doc
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Reddit social API
# API credentials: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret
REDDIT_USER_AGENT=trading-wens/1.0 by your-reddit-username
REDDIT_SUBREDDITS=stocks,investing,wallstreetbets

# Optional X source. Leave disabled unless an X API plan is configured.
# API: https://developer.x.com/en/portal/dashboard
X_ENABLED=false
X_BEARER_TOKEN=

# NLP inference service
NLP_SERVICE_URL=http://localhost:8001
NLP_SERVICE_TOKEN=replace-with-a-long-random-value
SENTIMENT_MODEL=ProsusAI/finbert
EVENT_MODEL=facebook/bart-large-mnli
MODEL_CACHE_DIR=.cache/models
MODEL_DEVICE=cpu

# Optional Hugging Face token for private models or higher download limits
# API token: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# Optional market prices used to value the stress-test portfolio
# API key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_API_URL=https://www.alphavantage.co/query

# Risk policy
HIGH_IMPACT_THRESHOLD=7
SIGNAL_RETENTION_DAYS=90
MAX_SOURCE_AGE_MINUTES=30
