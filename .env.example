# Go API
FRONTEND_URL=http://localhost:3000
BACKEND_ADDRESS=127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Neon PostgreSQL (use the pooled connection string in deployed environments)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=15
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=10

# Password authentication, signed sessions, and optional Google OAuth
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback
APP_SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=28800

# Alpaca market data and paper trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_DATA_REST_URL=https://data.alpaca.markets
ALPACA_TRADING_REST_URL=https://paper-api.alpaca.markets

# GDELT news API (no API key is required)
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Trained FinBERT inference service used by the Go API
FINBERT_INFERENCE_URL=http://127.0.0.1:8090
NLP_REQUEST_TIMEOUT_SECONDS=20

# Python inference process. Point this at the external trained checkpoint directory.
NLP_LISTEN_ADDRESS=127.0.0.1:8090
NLP_MODEL_DIR=
NLP_MODEL_NAME=trading-wens-sentiment
NLP_MODEL_VERSION=
NLP_MAX_BATCH_SIZE=64

# Bluesky public post search (no API key is required)
# API: https://docs.bsky.app/docs/api/app-bsky-feed-search-posts
BLUESKY_API_ENABLED=true
BLUESKY_API_BASE_URL=https://public.api.bsky.app
