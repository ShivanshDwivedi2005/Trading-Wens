# Go API
FRONTEND_URL=http://localhost:3000
BACKEND_ADDRESS=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth and signed application session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=28800

# Alpaca market data and paper trading
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_DATA_REST_URL=https://data.alpaca.markets
ALPACA_TRADING_REST_URL=https://paper-api.alpaca.markets

# GDELT news API (no API key is required)
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc

# X recent-search API. Enable after adding a bearer token with post-read access.
# API: https://docs.x.com/x-api/posts/search-recent-posts
X_ENABLED=false
X_API_URL=https://api.x.com
X_BEARER_TOKEN=
